# === Backend (sanalle-back) — variables para Railway ===
# Copiá estas claves en Railway → Service → Variables.
# NO commitees el .env real.

# --- Base de datos ---
# Podés pegar la DATABASE_URL de Railway tal cual (postgres:// o postgresql://):
# el backend la normaliza a postgresql+asyncpg:// automáticamente.
# En Railway conviene referenciarla: DATABASE_URL=${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/railway

# --- Seguridad / JWT ---
SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Identidad de la app (usado en PDFs/exports) ---
NEXT_PUBLIC_APP_NAME=Vitalnova

# --- Seed del usuario admin inicial (solo en DB fresca) ---
ADMIN_EMAIL=admin@sanalle.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-password
ADMIN_NOMBRE=Administrador

# --- Almacenamiento de recibos PDF ---
# En Railway el filesystem es efímero: montá un Volume en /app/storage/recibos
# (o usá S3 con las claves de abajo) para no perder los PDFs al redeployar.
PDF_STORAGE_PATH=/app/storage/recibos

# --- Integraciones (opcionales) ---
TOMTOM_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_KEY_PREFIX=uploads/sanalle
S3_URL=
S3_ENDPOINT_URL=
